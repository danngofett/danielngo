%% Invoice scanner flow for the myTrellis AI case study.
%% Dark steps are the person's; light steps are the system.
%% Deliberately high level: no model settings, prompts or thresholds.
%% output: src/assets/images/projects/trellis-ai/scan-flow.png
%% spacing: 30 40
flowchart LR
  A["<b>Upload</b><br/>a PDF or<br/>photo of an<br/>invoice"]
  B["<b>Prepare</b><br/>file checked<br/>and cleaned<br/>before reading"]
  C["<b>Extract</b><br/>AI reads it into<br/>a draft, matched<br/>to existing<br/>records"]
  D["<b>Check in code</b><br/>totals, tax and<br/>dates verified,<br/>doubts flagged"]
  E["<b>Review</b><br/>side by side<br/>with the original,<br/>uncertain fields<br/>highlighted"]
  F["<b>Approve</b><br/>only now is the<br/>invoice created"]

  A --> B --> C --> D --> E --> F

  classDef me fill:#111827,stroke:#111827,color:#ffffff
  class A,E,F me
