---
import BaseHead from '@components/BaseHead.astro'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import FormattedDate from '@components/FormattedDate.astro'
import Icon from '@components/Icon.astro'
import BaseImage from '@components/BaseImage.astro'

import type { CollectionEntry } from 'astro:content'

type Props = CollectionEntry<'blog' | 'projects'>['data']

const { title, description, updatedDate, featured_image_src } = Astro.props
---

<html lang="en">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={featured_image_src}
    />
  </head>

  <body class="bg-white transition duration-500 dark:bg-slate-900">
    <Header />

    <main id="main" tabindex="-1">
      <div class="grid w-full grid-cols-4 gap-x-4 px-6 md:grid-cols-8 lg:grid-cols-12 lg:gap-x-6">
        <div class="mx-auto w-full lg:col-span-8 lg:col-start-3">
          <div class="mx-auto flex max-w-3xl items-center gap-2 py-32 dark:text-white">
            <a
              href={`/projects`}
              class="back-link group inline-flex items-center gap-2 rounded-sm"
            >
              <Icon
                icon="arrow"
                className="h-6 w-6 rotate-90 transform transition-transform duration-200 group-hover:-translate-x-1 group-focus-visible:-translate-x-1 motion-reduce:transition-none"
              />
              <span class="relative -top-px underline-offset-4 group-hover:underline group-focus-visible:underline">
                Back to projects
              </span>
            </a>
          </div>
        </div>

        <div class="hero-image mx-auto mb-24 w-full lg:col-span-8 lg:col-start-3">
          {featured_image_src && (
            <BaseImage
              zoom={false}
              class="rounded-2xl"
              width={1020}
              height={510}
              format="webp"
              src={featured_image_src}
              alt=""
            />
          )}
        </div>

        <div class="col-span-full mb-16 lg:col-span-8 lg:col-start-3">
          <article class="prose mx-auto max-w-3xl dark:prose-invert">
            <div>
              <div class="title">
                <div class="date">
                  {updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )}
                </div>
                <h1>{title}</h1>
                <hr />
              </div>
              <slot />
            </div>
          </article>
        </div>
      </div>
    </main>

    <Footer />
  </body>
</html>
