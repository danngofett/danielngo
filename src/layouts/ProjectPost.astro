---
import BaseHead from '@components/BaseHead.astro'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import FormattedDate from '@components/FormattedDate.astro'
import Icon from '@components/Icon.astro'
import BaseImage from '@components/BaseImage.astro'
import TableOfContents from '@components/TableOfContents.astro'

import type { MarkdownHeading } from 'astro'
import type { CollectionEntry } from 'astro:content'

type Props = CollectionEntry<'projects'>['data'] & {
  headings?: MarkdownHeading[]
}

const {
  title,
  description,
  url,
  updatedDate,
  featured_image_src,
  tags,
  toc,
  unlisted,
  headings = [],
} = Astro.props
const SEO_TITLE = `${title} | Daniel Ngo`
---

<html lang="en">
  <head>
    <BaseHead title={SEO_TITLE} description={description} noindex={unlisted} />
  </head>

  <body class="transition duration-500 bg-white dark:bg-slate-900">
    <Header />

    <main>
      <div class="grid w-full grid-cols-4 px-6 gap-x-4 md:grid-cols-8 lg:grid-cols-12 lg:gap-x-6">
        <div class="w-full mx-auto col-span-full lg:col-span-8 lg:col-start-3">
          <div class="flex items-center max-w-3xl gap-2 py-8 mx-auto md:py-16 lg:py-32 dark:text-white">
            <Icon icon="arrow" className="h-6 w-6 rotate-90 transform" />
            <a href={`/projects`} class="relative -top-px">
              Back to projects
            </a>
          </div>
        </div>

        <div class="flex justify-center w-full mx-auto mb-6 hero-image col-span-full md:mb-12 lg:col-span-8 lg:col-start-3 lg:mb-24">
          {featured_image_src && (
            <BaseImage
              zoom={false}
              class="rounded-2xl"
              width={1020}
              height={510}
              format="webp"
              src={featured_image_src}
              alt={title}
              loading="eager"
              sizes="(min-width: 1024px) 1020px, 100vw"
            />
          )}
        </div>

        <div class="mb-16 col-span-full lg:col-span-8 lg:col-start-3">
          <article class="max-w-3xl mx-auto prose dark:prose-invert">
            <div>
              <div class="title">
                <div class="date">
                  {updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )}
                </div>

                <h1 class="mb-0">{title}</h1>

                {tags && tags?.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-4">
                    {tags.map((tech) => (
                      <span class="px-3 py-1 text-sm text-white bg-gray-500 rounded-full dark:bg-gray-700">
                        {tech}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              {url && (
                <p class="text-gray-500 text-md dark:text-white">
                  <a href={url} target="_blank" rel="noopener noreferrer">
                    🔗 Visit website
                  </a>
                </p>
              )}
              <hr />
            </div>
            {toc && <TableOfContents headings={headings} variant="inline" />}
            <slot />
          </article>
        </div>

        {toc && (
          <aside class="hidden xl:col-start-11 xl:col-span-2 xl:row-start-3 xl:block">
            <TableOfContents headings={headings} />
          </aside>
        )}
      </div>
    </main>

    <Footer />
  </body>
</html>
