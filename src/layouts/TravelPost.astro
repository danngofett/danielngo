---
import BaseHead from '@components/BaseHead.astro'
import Header from '@components/Header.astro'
import Footer from '@components/Footer.astro'
import Container from '@components/Container.astro'

const { title, seo_title, seo_description, featured_image_src, image } =
  Astro.props
---

<html lang="en">
  <head>
    <BaseHead
      title={seo_title}
      description={seo_description}
      image={featured_image_src ?? image}
    />
  </head>

  <body class="bg-white transition duration-500 dark:bg-slate-900">
    <Header />

    <main id="main" tabindex="-1">
      <Container>
        {title && <h1>{title}</h1>}

        <div class="flex flex-col gap-8 md:gap-16 lg:gap-24">
          <slot />
        </div>
      </Container>
    </main>

    <Footer />
  </body>
</html>
