---
import { getCollection } from 'astro:content'
import IntroHeader from '@components/IntroHeader.astro'
import LandingPageLayout from '@layouts/LandingPage.astro'

import Card from '@components/Card.astro'
import Spotlight from '@components/Spotlight.astro'

const entries = (await getCollection('projects')).filter(
  (entry) =>
    import.meta.env.DEV || (!entry.data.draft && !entry.data.unlisted),
)

const featuredPosts = entries
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.year - a.data.year)

const posts = entries.filter((entry) => !entry.data.featured)
---

<LandingPageLayout
  seo_title="Projects"
  seo_description="A selection of full-stack engineering work, from design systems and front ends to APIs and cloud delivery."
>
  <IntroHeader
    title="Projects"
    description="I'm a full-stack engineer based in Melbourne, Australia 🇦🇺. I build production-ready systems, from polished front ends and design systems to APIs and cloud delivery."
  />

  {
    featuredPosts.length > 0 && (
      <div class="grid grid-cols-1 gap-12">
        {featuredPosts.map((entry) => {
          return <Spotlight post={entry} />
        })}
      </div>
    )
  }

  <section>
    <ul class="grid gap-8 md:grid-cols-2 md:gap-12 lg:grid-cols-3 lg:gap-8">
      {posts.map((post) => <Card post={post} compact />)}
    </ul>
  </section>
</LandingPageLayout>
