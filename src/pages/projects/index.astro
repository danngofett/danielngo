---
import { getCollection } from 'astro:content'
import IntroHeader from '@components/IntroHeader.astro'
import LandingPageLayout from '@layouts/LandingPage.astro'

import Card from '@components/Card.astro'
import Spotlight from '@components/Spotlight.astro'

const entries = (await getCollection('projects')).filter(
  (entry) => import.meta.env.DEV || (!entry.data.draft && !entry.data.unlisted),
)

const featuredPosts = entries
  .filter((entry) => entry.data.featured)
  .sort((a, b) => b.data.year - a.data.year)

const fullSpotlights = featuredPosts.filter(
  (entry) => entry.data.spotlight === 'full',
)
const halfSpotlights = featuredPosts.filter(
  (entry) => entry.data.spotlight !== 'full',
)

const posts = entries.filter((entry) => !entry.data.featured)
---

<LandingPageLayout
  seo_title="Projects"
  seo_description="A selection of full-stack engineering work, from design systems and front ends to APIs and cloud delivery."
>
  <IntroHeader
    title="Projects"
    description="I'm a full-stack engineer based in Melbourne, Australia 🇦🇺. I build production-ready systems, from  frontend apps and design systems to APIs and cloud delivery."
  />

  {fullSpotlights.length > 0 && (
    <div class="grid grid-cols-1 gap-8 lg:gap-12">
      {fullSpotlights.map((entry) => (
        <Spotlight post={entry} />
      ))}
    </div>
  )}

  {halfSpotlights.length > 0 && (
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
      {halfSpotlights.map((entry) => (
        <Spotlight post={entry} stacked />
      ))}
    </div>
  )}

  <section>
    <ul class="grid gap-8 md:grid-cols-2 md:gap-12 lg:grid-cols-3 lg:gap-8">
      {posts.map((post) => (
        <Card post={post} compact />
      ))}
    </ul>
  </section>
</LandingPageLayout>
