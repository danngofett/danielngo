---
import LandingPageLayout from '@layouts/LandingPage.astro'
import { Content as Intro } from '@content/about/introduction.mdx'
import { Content as Bio } from '@content/about/bio.mdx'
import Icon from '@components/Icon.astro'
import IntroHeader from '@components/IntroHeader.astro'
import BaseImage from '@components/BaseImage.astro'

import { getCollection, render } from 'astro:content'

const rolesEntries = (await getCollection('roles')).sort(
  (a, b) => b.data.order - a.data.order,
)

const roles = await Promise.all(
  rolesEntries.map(async (entry) => ({
    data: entry.data,
    Content: (await render(entry)).Content,
  })),
)
---

<LandingPageLayout
  seo_title="About"
  seo_description="Melbourne-based graphic designer and full-stack developer. Shopify expert, designer, and photography enthusiast."
  featured_image_src="about/teamlab-fukuoka"
>
  <IntroHeader
    title="About"
    description="Hello, I'm Dan and currently residing in Melbourne, Australia 🇦🇺. Today I'm a Senior Front-end Developer at Monash University."
  />

  <div class="flex flex-col gap-24 px-4 py-12">
    <div
      class="relative mx-auto mb-12 grid w-full grid-cols-4 gap-x-4 md:grid-cols-8 lg:grid-cols-12 lg:gap-x-6"
    >
      <div class="col-span-full lg:col-span-8 lg:col-start-3">
        <h2
          class="text-3xl leading-tight text-black md:text-4xl dark:text-white"
        >
          👋 A bit about me
        </h2>

        <div class="mt-6 text-xl dark:text-white">
          <Intro />
        </div>
      </div>

      <div class="col-span-full mt-10 lg:col-span-10 lg:col-start-2 lg:mt-16">
        <div class="aspect-h-4 aspect-w-3 md:aspect-h-2 md:aspect-w-3">
          <BaseImage
            class="rounded-lg object-cover object-center transition-opacity"
            alt="Photo of Daniel Ngo at Fukuoka, TeamLab Forests"
            src="about/teamlab-fukuoka"
            width={2252}
            height={1346}
            format="webp"
          />
        </div>
      </div>

      <div
        class="prose dark:prose-invert col-span-full mt-8 max-w-full md:mt-12 lg:col-span-8 lg:col-start-3 lg:mt-16"
      >
        <Bio />
      </div>

      <div
        class="prose dark:prose-invert col-span-full mt-8 max-w-full md:mt-12 lg:col-span-10 lg:col-start-2 lg:mt-16"
      >
        <h2>Professional development</h2>

        <div class="grid gap-8 md:grid-cols-3">
          <div>
            <h3 class="text-primary dark:text-white">Design Expertise</h3>
            <ul>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Design Systems:</strong
                >
                <span class="prose-sm">
                  Creating design systems using Storybook.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Typography:</strong
                >
                <span class="prose-sm"
                  >Established fundamentals of typography design.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Publication Design:</strong
                >
                <span class="prose-sm">
                  Experienced in designing for publications and print-based
                  media.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Motion Design:</strong
                >
                <span class="prose-sm"
                  >Proficient in animation using Adobe After Effects.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Digital prototyping:</strong
                >
                <span class="prose-sm"
                  >Expertise in Figma, Sketch, and Invision.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Adobe Suite:</strong
                >
                <span class="prose-sm">
                  Proficient in Adobe Photoshop, Illustrator, and InDesign.
                </span>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-primary dark:text-white">Leadership Skills</h3>
            <ul>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Team Leadership:</strong
                >
                <span class="prose-sm">
                  Experienced in leading both small and large development teams.
                </span>
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Technical Communication:</strong
                >
                <span class="prose-sm">
                  Skilled in technical communication and documentation.
                </span>
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Risk Management:</strong
                >
                <span class="prose-sm">
                  Managing and resolving high-priority (P1) client risks.
                </span>
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Performance Management:</strong
                >
                <span class="prose-sm">
                  Conducted one-on-one meetings and performance reviews.
                </span>
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Mentorship:</strong
                >
                <span class="prose-sm">
                  Offered mentorship and engaged in paired programming
                  practices.
                </span>
              </li>
            </ul>
          </div>

          <div>
            <h3 class="text-primary dark:text-white">Technical Proficiency</h3>
            <ul>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Programming Languages:</strong
                >
                <span class="prose-sm">
                  Skilled in Vanilla JS and TypeScript.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Frameworks:</strong
                >
                <span class="prose-sm">
                  React, Next.js, Vue.js, Nuxt, Astro, and Lit.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Back-End Development:</strong
                >
                <span class="prose-sm"> Experienced in Node.js.</span>
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Web Development:</strong
                >
                <span class="prose-sm"
                  >HTML, Liquid, CSS, SASS, and PostCSS.</span
                >
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Content Management Systems:</strong
                >
                <span class="prose-sm">
                  Shopify, Contentful, Prismic, Sanity.io, and WordPress.
                </span>
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >API Integration:</strong
                >
                <span class="prose-sm">GraphQL and REST APIs.</span>
              </li>
              <li>
                <strong class="text-primary block dark:text-white"
                  >Testing Tools:</strong
                >
                <span class="prose-sm"
                  >Playwright, Vitest, Cypress, and Jest.</span
                >
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div
        class="col-span-full mt-8 max-w-full md:mt-12 lg:col-span-8 lg:col-start-3 lg:mt-16"
      >
        <h2 class="mb-8 text-2xl font-bold text-black dark:text-white">
          Experience
        </h2>

        {
          roles.map(({ data, Content }) => (
            <details class="group dark:prose-invert mb-4 rounded-2xl shadow-md dark:bg-slate-800 dark:text-white dark:outline-white dark:hover:outline-2">
              <summary class="flex w-full cursor-pointer items-center justify-center gap-6 rounded-md py-4 pr-8 pl-6">
                <div class="flex-shrink-0">
                  <BaseImage
                    class="m-0 h-12 w-12 rounded-full"
                    src={data.logo}
                    alt={data.company}
                    width={96}
                    height={96}
                    format="webp"
                  />
                </div>

                <div class="prose space-y-0">
                  <h2 class="not-prose text-primary my-0 text-xl font-normal dark:text-white">
                    {data.company} / {data.role}
                  </h2>

                  <p class="mb-0 dark:text-white">{data.date}</p>
                </div>

                <div class="ml-auto flex-shrink-0">
                  <Icon
                    icon="arrow"
                    className="ml-auto transition-transform ease-in-out group-open:rotate-180"
                  />
                </div>
              </summary>

              <div class="prose dark:prose-invert max-w-[unset] border-t-[1px] border-gray-200 p-8 dark:border-gray-800 dark:text-white">
                <Content />
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</LandingPageLayout>
