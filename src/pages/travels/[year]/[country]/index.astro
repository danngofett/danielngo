---
import { getCollection, render } from 'astro:content'
import Icon from '@components/Icon.astro'
import BaseImage from '@components/BaseImage.astro'
import Container from '@components/Container.astro'

import TravelPost from '@layouts/TravelPost.astro'
import { dateFormatter } from '@helpers/date-formatter'

export async function getStaticPaths() {
  const entries = await getCollection('travels')

  return entries.map((entry) => {
    const { data } = entry
    const slug = entry.id.split('/').pop()

    return {
      params: { year: data.year, country: slug },
      props: { entry },
    }
  })
}

const { entry } = Astro.props

const timeline = await getCollection('timeline').then((day) => {
  return day
    .filter((item) => item.data.country === entry.data.country)
    .sort((a, b) => a.data.day - b.data.day)
})

const { Content } = await render(entry)
---

<TravelPost
  seo_title={`${entry.data.title} | Daniel Ngo`}
  image={entry.data.featured_image_src}
>
  <Container>
    <div class="dark:text-white">
      <div
        class="flex items-center gap-2 py-8 md:py-16 lg:py-32 dark:text-white"
      >
        <Icon icon="arrow" className="h-6 w-6 rotate-90 transform" />
        <a href="/travels" class="relative -top-px">Back to travels</a>
      </div>
    </div>

    <div class="py-8 md:py-12 lg:py-24">
      <h1 class="mb-2 text-5xl dark:text-white">{entry.data.title}</h1>
      <p class="text-gray-500 dark:text-gray-200">
        {dateFormatter(entry.data.publishDate)}
      </p>
    </div>

    {
      entry.data.featured_image_src && (
        <div class="mb-24 overflow-hidden rounded-2xl">
          <BaseImage
            class="block"
            src={entry.data.featured_image_src}
            alt={entry.data.featured_image_alt || ''}
            height={1824}
            width={2736}
            format="webp"
          />
        </div>
      )
    }

    <div class="max-w-full mx-auto my-24 prose dark:prose-invert lg:px-16">
      <div class="mb-4">
        <a href="#photos" class="text-sm">📸 Jump to photos</a>
      </div>

      <Content />
    </div>

    <div id="photos" class="md:px-8 lg:px-16 dark:text-white">
      {
        timeline.length > 0 && (
          <div class="mb-24">
            <h2 class="mb-8 text-3xl">Timeline</h2>

            <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
              {timeline.map((item) => (
                <a
                  href={`/travels/${item.id}`}
                  class="flex items-center gap-4 px-4 py-2 transition-shadow rounded-lg shadow-md outline-slate-500 hover:shadow-lg hover:outline-2 dark:bg-slate-800 dark:hover:outline-white"
                >
                  {item.data.featured_image_src && (
                    <div class="relative shrink-0 w-12 h-12 bg-gray-200 rounded-full">
                      <BaseImage
                        src={item.data.featured_image_src}
                        alt={item.data.featured_image_alt || ''}
                        height={120}
                        width={120}
                        class="object-cover w-12 h-12 rounded-full"
                        format="webp"
                      />
                    </div>
                  )}

                  <div>
                    <p class="text-gray-500 dark:text-slate-200">
                      Day {item.data.day}
                    </p>
                    <h3 class="mb-2 text-xl">{item.data.title}</h3>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }
    </div>
  </Container>
</TravelPost>
