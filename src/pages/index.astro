---
import BaseHead from "@components/BaseHead.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Button from "@components/Button.astro";
import TextReveal from "@components/TextReveal";
import Container from "@components/Container.astro";

import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

const FOCUS_AREAS = [
  "AI agents",
  "API and system integration",
  "HITL workflow automation",
  "MCP servers",
  "developer and design systems",
  "accessible interfaces",
  "multi-tenant SaaS",
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>

  <body class="antialiased bg-white transition duration-500 dark:bg-slate-900">
    <h1 class="sr-only">{SITE_TITLE}</h1>

    <Header title={SITE_TITLE} />

    <Container>
      <header class="flex flex-col gap-24 px-4 py-12 md:py-24 lg:py-36">
        <div class="flex items-center gap-24">
          <div class="grid lg:grid-cols-5">
            <div class="col-span-3 py-3">
              <h2 class="text-3xl leading-tight text-black md:text-4xl dark:text-white">
                Full-stack engineer building production systems with a focus on
                <TextReveal
                  className="relative top-2.25"
                  client:load
                  words={FOCUS_AREAS}
                  duration={1000}
                />
              </h2>
            </div>
          </div>
        </div>

        <div class="mr-auto flex flex-col gap-4">
          <div>
            <Button href="/projects">View my projects</Button>
          </div>

          <div>
            <Button href="/travels" variant="secondary">
              Follow my travels
            </Button>
          </div>
        </div>
      </header>
    </Container>
    <Footer />
  </body>
</html>
