---
import { getCollection } from 'astro:content'
import LandingPageLayout from '@layouts/LandingPage.astro'
import IntroHeader from '@components/IntroHeader.astro'
import Card from '@components/Card.astro'

const posts = (await getCollection('blog')).sort(
  (a, b) => a.data.publishDate.valueOf() - b.data.publishDate.valueOf(),
)
---

<LandingPageLayout
  seo_title="Blog"
  seo_description="A collection of opinions related to design, development, guides, technology trends that I find interesting and want to share with the world."
>
  <IntroHeader
    title="Blog"
    description="A collection of articles about web development, design, and other things I find interesting. I write about what I learn, and I hope you learn something too."
  />

  <section>
    <ul class="grid grid-cols-2 gap-16">
      {posts.map((post) => (
        <Card post={post} />
      ))}
    </ul>
  </section>
</LandingPageLayout>
