---
import { linkResolver } from '@utils/link-resolver'

import type { CollectionEntry } from 'astro:content'
import BaseImage from './BaseImage.astro'
import CardCta from './CardCta.astro'

interface Props {
  post: CollectionEntry<'travels' | 'projects'>
  stacked?: boolean
  /** Show the "YYYY Spotlight" label above the title. */
  showLabel?: boolean
  /** Eager only for the image that is likely above the fold. */
  loading?: 'eager' | 'lazy'
}

const { data, collection } = Astro.props.post
const { stacked = false, showLabel = true, loading = 'lazy' } = Astro.props

// Rendered image width per breakpoint, mirroring the grid classes below
// (container + section + card padding), so the browser picks a fitting file.
const sizes = stacked
  ? '(min-width: 1280px) 500px, (min-width: 1024px) 370px, (min-width: 768px) 610px, calc(100vw - 7rem)'
  : '(min-width: 1280px) 720px, (min-width: 1024px) 420px, (min-width: 768px) 240px, calc(100vw - 7rem)'
---

<a
  class:list={[
    'border-shimmer group relative mx-auto grid w-full cursor-pointer rounded-2xl border-4 border-white bg-gray-100 dark:border-gray-800 dark:bg-gray-800 dark:lg:bg-gray-800',
    stacked
      ? 'grid-cols-1 gap-5 p-5 md:gap-8 md:p-8'
      : 'grid-cols-1 gap-5 p-5 md:grid-cols-[1fr_240px] md:gap-8 md:p-8 lg:grid-cols-[1fr_420px] lg:gap-12 xl:grid-cols-[1fr_720px]',
  ]}
  href={linkResolver(Astro.props.post)}
>
  <div
    class:list={[
      'items-stretch order-2 block h-full md:space-y-4',
      stacked
        ? 'md:flex md:flex-col md:justify-between'
        : 'md:order-1 lg:flex lg:flex-col lg:justify-between lg:px-6 lg:py-12',
    ]}
  >
    <div class="space-y-2 md:space-y-4 md:pr-8">
      {showLabel && (
        <h2 class="hidden mb-2 font-normal text-black text-md md:block md:text-lg dark:text-white">
          {data.year} Spotlight
        </h2>
      )}

      <h3 class="text-xl leading-tight text-black md:text-3xl lg:text-4xl dark:text-white">
        {data.title}
      </h3>

      <p class="mt-2 text-base font-normal text-slate-600 md:text-xl dark:text-slate-200">
        {data.description}
      </p>
    </div>

    <div class="mt-6 text-base font-normal md:mt-8 md:text-xl">
      <CardCta>View {collection === 'travels' ? 'article' : 'project'}</CardCta>
    </div>
  </div>

  {data.featured_image_src && (
    <div class:list={['order-1', stacked && 'md:order-0 md:row-start-1']}>
      <BaseImage
        zoom={false}
        src={data.featured_image_src}
        alt={data.featured_image_alt || data.title || ''}
        width={3840}
        height={1920}
        format="webp"
        class="block rounded-lg"
        loading={loading}
        sizes={sizes}
      />
    </div>
  )}
</a>
