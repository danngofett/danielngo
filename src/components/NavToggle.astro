---
import Icon from './Icon.astro'

const { isActive } = Astro.props
---

<nav-toggle>
  <button class="rounded-full border p-1 transition-colors hover:border-slate-600 dark:text-white">
    <span class="icon visible md:hidden">
      {isActive ? <Icon icon="close" /> : <Icon icon="hamburger" />}
    </span>
  </button>
</nav-toggle>

<script>
  import debounce from 'lodash.debounce'

  class NavToggle extends HTMLElement {
    constructor() {
      super()

      const button = this.querySelector('button')!

      const setTheme = (isActive: boolean) => {
        document.documentElement.classList[isActive ? 'add' : 'remove'](
          'nav-active',
        )
        button.setAttribute('aria-pressed', String(isActive))
      }

      button.addEventListener('click', () => setTheme(!this.isActive()))

      setTheme(this.isActive())

      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && this.isActive()) {
          setTheme(false)
        }
      })

      window.addEventListener(
        'resize',
        debounce(() => {
          if (window.innerWidth > 768) {
            setTheme(false)
          }
        }, 250),
      )
    }

    isActive() {
      return document.documentElement.classList.contains('nav-active')
    }
  }

  customElements.define('nav-toggle', NavToggle)
</script>
