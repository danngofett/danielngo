---
import Icon from './Icon.astro'

const { isActive } = Astro.props
---

<nav-toggle>
  <button
    type="button"
    class="flex size-11 items-center justify-center rounded-full border transition-colors hover:border-slate-600 dark:text-white"
    aria-label={isActive ? 'Close menu' : 'Open menu'}
    aria-controls="nav-drawer"
    aria-expanded="false"
  >
    <span class="icon visible lg:hidden" aria-hidden="true">
      {isActive ? <Icon icon="close" /> : <Icon icon="hamburger" />}
    </span>
  </button>
</nav-toggle>

<script>
  import debounce from 'lodash.debounce'

  const root = document.documentElement
  const isActive = () => root.classList.contains('nav-active')

  // Single source of truth: the class on <html>, mirrored to aria-expanded on
  // every toggle and to `inert` on the drawer so its links are unreachable
  // (tab and screen reader) while it is closed.
  const setActive = (active: boolean) => {
    root.classList.toggle('nav-active', active)
    document.getElementById('nav-drawer')?.toggleAttribute('inert', !active)
    document
      .querySelectorAll('nav-toggle button')
      .forEach((button) => button.setAttribute('aria-expanded', String(active)))
  }

  class NavToggle extends HTMLElement {
    constructor() {
      super()

      const button = this.querySelector('button')!

      button.addEventListener('click', () => {
        const next = !isActive()
        setActive(next)

        // Move focus into the drawer on open, back to the opener on close.
        const target = next
          ? '#nav-drawer nav-toggle button'
          : '[data-nav-opener] nav-toggle button'
        document.querySelector<HTMLElement>(target)?.focus()
      })
    }
  }

  customElements.define('nav-toggle', NavToggle)

  // Page-level listeners, registered once (the element is used twice).
  setActive(isActive())

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && isActive()) {
      setActive(false)
      document
        .querySelector<HTMLElement>('[data-nav-opener] nav-toggle button')
        ?.focus()
    }
  })

  window.addEventListener(
    'resize',
    debounce(() => {
      if (window.innerWidth >= 1024) {
        setActive(false)
      }
    }, 250),
  )
</script>
