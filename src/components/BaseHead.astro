---
import '@styles/global.css'
import '@styles/animation.css'
import '@styles/lightbox.css'
import { Font } from 'astro:assets'
import {
  DEFAULT_OG_IMAGE,
  OG_HEIGHT,
  OG_WIDTH,
  getOgImageUrl,
} from '@utils/og-image'
interface Props {
  title: string
  description: string
  image?: string
  noindex?: boolean
  /** Preload the Medium weight, for pages with buttons above the fold. */
  preloadMedium?: boolean
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const {
  title,
  description,
  image,
  noindex = false,
  preloadMedium = false,
} = Astro.props

const ogImage = await getOgImageUrl(image || DEFAULT_OG_IMAGE, Astro.site ?? Astro.url)

const fontPreloads = [
  { weight: 400, style: 'normal' },
  ...(preloadMedium ? [{ weight: 500, style: 'normal' }] : []),
  { weight: 600, style: 'normal' },
  { weight: 700, style: 'normal' },
]
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-light.svg"
  media="(prefers-color-scheme:no-preference)"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-dark.svg"
  media="(prefers-color-scheme:dark)"
/>
<link
  rel="icon"
  type="image/svg+xml"
  href="/favicon-light.svg"
  media="(prefers-color-scheme:light)"
/>

<meta name="generator" content={Astro.generator} />

<!-- Fonts -->
<Font cssVariable="--font-graphik" preload={fontPreloads} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
) : (
  <>
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Daniel Ngo" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />
  </>
)}

<script is:inline>
  const STORAGE_KEY = 'theme'

  if (typeof localStorage !== 'undefined') {
    const theme = localStorage.getItem(STORAGE_KEY)

    const prefersDark =
      theme === null && window.matchMedia('(prefers-color-scheme: dark)').matches

    if (theme === 'dark' || prefersDark) {
      document.documentElement.classList.add('dark')
    }
  }
</script>
