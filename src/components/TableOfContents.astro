---
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
  variant?: 'sticky' | 'inline'
}

const { headings, variant = 'sticky' } = Astro.props

const items = headings.filter((h) => h.depth === 2 || h.depth === 3)

const linkClass =
  'toc-link block border-l-2 border-transparent py-1 pl-3 text-sm text-gray-500 transition-colors hover:text-gray-900 dark:text-gray-400 dark:hover:text-white'
---

{
  items.length > 1 && variant === 'sticky' && (
    <nav aria-label="Table of contents" class="toc sticky top-8">
      <p class="mb-3 text-xs font-semibold tracking-widest text-gray-900 uppercase dark:text-white">
        On this page
      </p>
      <ul class="m-0 list-none space-y-0.5 border-l border-gray-200 p-0 dark:border-gray-700">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-3' : ''}>
            <a href={`#${h.slug}`} class={`${linkClass} -ml-px`}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  items.length > 1 && variant === 'inline' && (
    <details class="toc not-prose mb-8 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3 dark:border-gray-700 dark:bg-gray-800">
      <summary class="cursor-pointer text-sm font-semibold text-gray-900 dark:text-white">
        On this page
      </summary>
      <ul class="mt-3 list-none space-y-0.5 p-0">
        {items.map((h) => (
          <li class={h.depth === 3 ? 'pl-4' : ''}>
            <a href={`#${h.slug}`} class={linkClass}>
              {h.text}
            </a>
          </li>
        ))}
      </ul>
    </details>
  )
}

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
  .prose :where(h2, h3)[id] {
    scroll-margin-top: 2rem;
  }
  .toc-link[aria-current='true'] {
    border-color: currentColor;
    font-weight: 600;
    color: rgb(17 24 39);
  }
  .dark .toc-link[aria-current='true'] {
    color: white;
  }
</style>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('nav.toc .toc-link'),
  )
  const targets = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((el): el is HTMLElement => el !== null)

  if (targets.length > 0) {
    const setActive = (id: string) => {
      for (const link of links) {
        if (link.hash === `#${id}`) link.setAttribute('aria-current', 'true')
        else link.removeAttribute('aria-current')
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .map((e) => e.target.id)
        if (visible.length > 0) setActive(visible[0])
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 },
    )
    targets.forEach((el) => observer.observe(el))
    setActive(targets[0].id)
  }
</script>
