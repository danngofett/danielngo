---
export interface IntroHeaderProps {
  title: string
  description: string
}

const { title, description } = Astro.props as IntroHeaderProps
---

<header class="my-12 flex flex-col gap-24 px-4 md:my-24 lg:py-36">
  <div class="flex items-center gap-24">
    <div class="grid lg:grid-cols-5">
      <div class="col-span-3 py-3">
        <h1 class="sr-only" set:html={title} />
        <h2
          class="text-2xl leading-tight text-black md:text-3xl lg:text-4xl dark:text-white"
          set:html={description}
        />
      </div>
    </div>
  </div>
</header>
