---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props

const { pathname } = Astro.url
const isActive = href === pathname || href === pathname.replace(/\/$/, '')
---

<a
  href={href}
  class="hover:after:"
  class:list={[
    'underline-animation text-secondary outline- inline-block text-lg font-normal whitespace-nowrap focus:outline-2 active:focus:outline-0',
    className,
    { active: isActive },
  ]}
  {...props}
>
  <slot />
</a>
