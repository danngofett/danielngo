---
import { linkResolver } from '@utils/link-resolver'

import type { CollectionEntry } from 'astro:content'
import BaseImage from './BaseImage.astro'
import CardCta from './CardCta.astro'

interface Props {
  post: CollectionEntry<'travels' | 'projects' | 'blog'>
  compact?: boolean
  /** Horizontal layout: thumbnail on the left, text on the right. */
  inline?: boolean
}

const { data, collection } = Astro.props.post
const isDraft = Astro.props.post.data.draft
const { compact = false, inline = false } = Astro.props
---

<a
  class:list={[
    'border-shimmer group relative rounded-2xl border-4 border-white dark:border-slate-800',
    inline
      ? 'grid grid-cols-[120px_1fr] gap-x-4 gap-y-2 bg-gray-100 p-4 md:grid-cols-[260px_1fr] md:gap-x-8 md:p-6 dark:bg-gray-800'
      : [
          'flex flex-col gap-5 bg-gray-100 p-5 md:gap-8 md:p-8 dark:bg-gray-800',
          compact && 'lg:gap-5 lg:p-6',
        ],
  ]}
  href={linkResolver(Astro.props.post)}
>
  {data.featured_image_src && (
    <div class:list={['relative', inline && 'row-span-2 self-center']}>
      <BaseImage
        zoom={false}
        src={data.featured_image_src}
        alt={data.featured_image_alt || ''}
        width={1200}
        format="webp"
        height={687}
        class="w-full rounded-xl object-fill"
      />
    </div>
  )}

  <div class:list={[inline ? 'self-end' : 'mb-auto']}>
    {isDraft && (
      <p class="text-md mb-6 font-normal text-slate-500 italic dark:text-slate-300">
        In progress
      </p>
    )}

    <h3
      class:list={[
        'text-xl leading-tight text-black dark:text-white',
        inline ? 'md:text-2xl' : 'md:text-3xl',
        compact && 'lg:text-2xl',
      ]}
    >
      {data.title}
    </h3>

    <p
      class:list={[
        'mt-2 font-normal text-slate-500 dark:text-slate-300',
        inline
          ? 'line-clamp-3 text-sm leading-snug md:line-clamp-none md:text-base md:leading-normal'
          : 'md:text-xl',
        compact && 'lg:text-base',
      ]}
    >
      {data.description}
    </p>
  </div>

  <div class:list={[inline ? 'hidden self-start md:block' : 'mt-auto']}>
    {!isDraft && (
      <CardCta
        class:list={[
          'text-base font-normal md:text-xl',
          compact && 'lg:text-base',
        ]}
      >
        View {collection === 'travels' ? 'article' : 'project'}
      </CardCta>
    )}
  </div>
</a>
