---
import { v2 as cloudinary } from 'cloudinary'
import { CldImage } from 'astro-cloudinary'
import { Image, getImage } from 'astro:assets'
import type { ImageMetadata } from 'astro'
import type { CldImageProps } from 'astro-cloudinary'

interface Props {
  src: string
  alt: string
  caption?: string
  width?: number
  height?: number
  format?: string
  class?: string
  loading?: CldImageProps['loading']
  /** Click to enlarge in a lightbox. On by default; turn off for heroes, cards and avatars. */
  zoom?: boolean
  /** Rendered width hint for the browser's srcset choice. Defaults to the 768px article column. */
  sizes?: string
}

const {
  src,
  alt,
  caption,
  width,
  height,
  format,
  class: classes,
  loading = 'lazy',
  zoom = true,
  sizes = '(min-width: 768px) 768px, 100vw',
} = Astro.props

// Interim local images: a file at src/assets/images/<src>.<ext> is used in
// preference to Cloudinary, so `src="projects/trellis/roots"` resolves to
// src/assets/images/projects/trellis/roots.png. Once an image is uploaded to
// Cloudinary under the same id, delete the local file and nothing else changes.
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
)
const localPrefix = '/src/assets/images/'
const local = Object.entries(localImages).find(
  ([path]) => path.slice(localPrefix.length).replace(/\.[^.]+$/, '') === src,
)?.[1].default

// Building a delivery URL only needs the cloud name; never add the API key or
// secret here.
cloudinary.config({
  cloud_name: import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME,
})

const imageSrc = cloudinary.url(src, {
  width: width,
  height: height,
  crop: 'fill',
  quality: 'auto',
  fetch_format: 'webp',
})

const imageClass = [
  classes,
  'rounded-xl',
  caption && 'mb-4 border border-neutral-100',
]
  .filter(Boolean)
  .join(' ')

// Responsive widths for local images, up to 2x of a ~1000px slot and never
// larger than the original.
const responsiveWidths = local
  ? [
      ...new Set(
        [480, 768, 1152, 1536, 2048]
          .filter((w) => w < local.width)
          .concat(local.width),
      ),
    ].filter((w) => w <= 2048)
  : []

// Larger version for the lightbox; never upscaled past the original.
const zoomSrc = !zoom
  ? undefined
  : local
    ? (
        await getImage({
          src: local,
          width: Math.min(local.width, 2400),
          format: 'webp',
          quality: 85,
        })
      ).src
    : cloudinary.url(src, {
        width: 2400,
        crop: 'limit',
        quality: 'auto',
        fetch_format: 'webp',
      })

const Wrapper = zoom ? 'button' : 'div'
const wrapperProps = zoom
  ? {
      type: 'button',
      class: 'image-zoom',
      'data-zoom-src': zoomSrc,
      'data-zoom-alt': alt,
      'data-zoom-caption': caption,
      'aria-label': `Enlarge image: ${alt}`,
    }
  : {}
---

<div class="space-y-4">
  <Wrapper {...wrapperProps}>
    {local ? (
      <Image
        class={imageClass}
        src={local}
        alt={alt}
        format="webp"
        quality={80}
        loading={loading}
        width={width ?? Math.min(local.width, 1600)}
        height={height}
        fit="cover"
        widths={responsiveWidths}
        sizes={sizes}
      />
    ) : (
      <CldImage
        class={imageClass}
        src={imageSrc}
        alt={alt}
        format={format}
        crop="fill"
        quality={80}
        loading={loading}
        width={width}
        height={height}
        sizes="100vw"
      />
    )}
  </Wrapper>

  {caption && (
    <p class="mt-0 text-sm italic text-gray-500 dark:text-white">{caption}</p>
  )}
</div>

<script>
  import { initImageLightbox } from '@utils/image-lightbox'
  initImageLightbox()
</script>
