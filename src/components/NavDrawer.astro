---
import HeaderLink from './HeaderLink.astro'
import NavToggle from './NavToggle.astro'
---

<div class="nav-drawer fixed top-0 left-0 z-50 h-full w-full -translate-x-full bg-slate-50 p-4 transition-transform duration-300 ease-in-out md:w-[380px] dark:bg-slate-800">
  <div class="absolute right-8">
    <NavToggle isActive />
  </div>

  <div class="flex flex-col gap-2 py-16 dark:text-white">
    <div>
      <HeaderLink class="inline-block px-5 py-2" href="/">
        Home
      </HeaderLink>
    </div>
    <div>
      <HeaderLink class="inline-block px-5 py-2" href="/about">
        About
      </HeaderLink>
    </div>
    <div>
      <HeaderLink class="inline-block px-5 py-2" href="/projects">
        Projects
      </HeaderLink>
    </div>
    <div>
      <HeaderLink class="inline-block px-5 py-2" href="/travels">
        Travels
      </HeaderLink>
    </div>
  </div>
</div>
