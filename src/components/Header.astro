---
import HeaderLink from './HeaderLink.astro'
import { SITE_TITLE } from '../consts'
import Icon from '@components/Icon.astro'
import ThemeToggle from './ThemeToggle.astro'
import NavToggle from './NavToggle.astro'
import NavDrawer from './NavDrawer.astro'
import Container from './Container.astro'
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] focus:rounded-md focus:bg-black focus:px-4 focus:py-2 focus:text-white dark:focus:bg-white dark:focus:text-black"
>
  Skip to content
</a>

<Container>
  <div class="flex items-center justify-between gap-4 py-4 md:py-6">
    <div class="logo flex items-center gap-2 text-2xl dark:text-white">
      <div class="w-10" aria-hidden="true">
        <Icon icon="danielngo" aria-hidden="true" />
      </div>

      <a class="underline-animation font-bold" href="/">
        {SITE_TITLE}
      </a>
    </div>

    <nav aria-label="Main" class="hidden gap-4 lg:flex dark:text-white">
      <HeaderLink class="px-5 py-2" href="/">
        Home
      </HeaderLink>
      <HeaderLink class="px-5 py-2" href="/about">
        About
      </HeaderLink>
      <HeaderLink class="px-5 py-2" href="/projects">
        Projects
      </HeaderLink>
      <!-- <HeaderLink class="px-5 py-2" href="/blog">Blog</HeaderLink> -->
      <HeaderLink class="px-5 py-2" href="/travels">
        Travels
      </HeaderLink>
    </nav>

    <NavDrawer />

    <div class="flex gap-4">
      <div class="lg:hidden" data-nav-opener>
        <NavToggle />
      </div>

      <ThemeToggle />
    </div>
  </div>
</Container>
