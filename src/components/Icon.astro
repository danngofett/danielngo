---
import { parse } from 'node-html-parser'

export interface Props {
  icon: string
  className?: string
}

export interface SVG {
  attributes: Record<string, string>
  innerHTML: string
}

const getSVG = (name: string) => {
  const filepath = `/src/assets/icons/${name}.svg`
  const files = import.meta.glob<string>('/src/assets/icons/**/*.svg', {
    as: 'raw',
    eager: true,
  })

  if (!(filepath in files)) {
    throw new Error(`${filepath} not found`)
  }

  const root = parse(files[filepath])

  const svg = root.querySelector('svg')
  const { attributes, innerHTML } = svg as SVG

  return {
    attributes,
    innerHTML,
  }
}

const { icon, className, ...attributes } = Astro.props as Props
const { attributes: baseAttributes, innerHTML } = getSVG(icon)

const svgAttributes = { ...baseAttributes, ...attributes }
---

<svg {...svgAttributes} set:html={innerHTML} class={className} />
